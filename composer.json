{
  "name": "bytes-commerce/finance-ts-api",
  "description": "PHP Library for FinTS 3.0 (formerly phpFinTS)",
  "homepage": "https://github.com/bytes-commerce/finance-ts-api",
  "version": "4.0.0",
  "license": "MIT",
  "autoload": {
    "psr-4": {
      "BytesCommerce\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "BytesCommerce\\Tests\\": "tests/"
    }
  },
  "require": {
    "php": ">=8.0",
    "psr/log": "^1|^2|^3",
    "ext-curl": "*",
    "ext-mbstring": "*",
    "ext-libxml": "*",
    "ext-simplexml": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.5",
    "php-mock/php-mock-phpunit": "^2.6",
    "friendsofphp/php-cs-fixer": "^3.0"
  },
  "suggest": {
    "monolog/monolog": "Allow sending log messages to a variety of different handlers",
    "abcaeffchen/sephpa": "1.*",
    "nemiah/php-sepa-xml": "dev-master"
  },
  "scripts": {
    "test": [
      "phpunit"
    ],
    "check": [
      "@cs"
    ],
    "cs": "php-cs-fixer fix -v --diff --dry-run",
    "cs-fix": "php-cs-fixer fix -v --diff"
  }
}
